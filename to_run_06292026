-- Insert missing invoice tags into the base tags table
INSERT INTO tags (tag_id, tag_name, created_at)
SELECT tag_id, tag_name, created_at
FROM invoice_tags
ON CONFLICT (tag_id) DO UPDATE SET tag_name = EXCLUDED.tag_name;

-- Insert missing expense tags into the base tags table
INSERT INTO tags (tag_id, tag_name, created_at)
